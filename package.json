{
  "name": "@tailos/root",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @tailos/api run dev",
    "lint": "oxlint --no-error-on-unmatched-pattern .",
    "lint:commits": "commitlint --default-config",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "husky": "9.1.7",
    "oxfmt": "0.75.0",
    "oxlint": "1.89.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.15.0"
}
