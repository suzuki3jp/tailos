{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-console": "error",
    "typescript/no-non-null-asserted-optional-chain": "warn",
    "typescript/no-this-alias": "off",
    "unicorn/no-empty-file": "off",
    "tailos/api-layers": "error",
    "tailos-web/boundaries": "error",
    "tailos-style/no-nested-ternary": "error"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/.wrangler/**",
    "**/temp/**",
    ".claude/worktrees/**"
  ],
  "jsPlugins": [
    "./lint/api-layers.mjs",
    "./lint/web-boundaries.mjs",
    "./lint/no-nested-ternary.mjs"
  ]
}
