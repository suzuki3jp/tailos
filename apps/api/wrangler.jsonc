{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tailos-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "vars": {
    "TAILOS_PUBLIC_ORIGIN": "http://localhost:8787",
    "TAILOS_WEB_ORIGIN": "http://localhost:3000",
  },
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "traces": { "enabled": true },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tailos",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "r2_buckets": [
    { "binding": "RUN_ARTIFACTS", "bucket_name": "tailos-run-artifacts" },
  ],
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": {
    "bindings": [
      { "name": "RUNNER", "class_name": "RunnerContainer" },
      { "name": "SESSION_STREAM", "class_name": "SessionStream" },
      { "name": "CREDENTIALS", "class_name": "CredentialBroker" },
    ],
  },
  "migrations": [
    { "tag": "runner-v1", "new_sqlite_classes": ["RunnerContainer"] },
    { "tag": "credentials-v1", "new_sqlite_classes": ["CredentialBroker"] },
    { "tag": "session-stream-v1", "new_sqlite_classes": ["SessionStream"] },
  ],
  "containers": [
    {
      "class_name": "RunnerContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "runner": {
          "dockerfile": "../runner/Dockerfile",
          "build_context": "../runner",
        },
      },
    },
  ],
}
