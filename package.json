{
  "name": "@tailos/root",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @tailos/api run dev",
    "lint": "pnpm run lint:code && pnpm run lint:fsd",
    "lint:code": "oxlint --threads=1 --no-error-on-unmatched-pattern .",
    "lint:fsd": "pnpm --filter @tailos/web run lint:fsd",
    "lint:commits": "commitlint --default-config",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "node --disable-warning=ExperimentalWarning --test lint/*.test.mjs tools/pdr/pdr.test.mjs tools/preview/*.test.mjs && pnpm run pdr:check && pnpm -r --if-present run test",
    "typecheck": "tsc -b --stopBuildOnErrors",
    "prepare": "husky",
    "pdr": "node --disable-warning=ExperimentalWarning tools/pdr/cli.mjs",
    "pdr:check": "node --disable-warning=ExperimentalWarning tools/pdr/cli.mjs check",
    "pdr:test": "node --disable-warning=ExperimentalWarning --test tools/pdr/pdr.test.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@feature-sliced/steiger-plugin": "0.8.2",
    "husky": "9.1.7",
    "js-yaml": "4.3.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.89.0",
    "steiger": "0.9.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.15.0"
}
