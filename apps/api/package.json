{
  "name": "@meguri/api",
  "private": true,
  "type": "module",
  "exports": {
    "./browser": {
      "types": "./src/bootstrap/http.ts"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @meguri/runner run build && wrangler d1 migrations apply DB --local && wrangler dev --local",
    "provision": "node scripts/provision-resources.mjs",
    "deploy": "node --experimental-strip-types scripts/deploy.mjs",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run --fsModuleCachePath node_modules/.vitest-cache",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.15",
    "@meguri/core": "workspace:*",
    "better-auth": "1.7.15",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.10",
    "jose": "6.2.14",
    "valibot": "1.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "@types/node": "22.19.0",
    "drizzle-kit": "0.31.8",
    "esbuild": "0.28.2",
    "jsonc-parser": "3.3.1",
    "miniflare": "5.20261006.2-beta",
    "wrangler": "4.150.0"
  }
}
