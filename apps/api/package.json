{
  "name": "@meguri/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @meguri/runner run build && wrangler d1 migrations apply DB --local && wrangler dev --local",
    "deploy": "pnpm --filter @meguri/runner run build && node scripts/deploy.mjs",
    "db:generate": "drizzle-kit generate",
    "test": "node --experimental-strip-types --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@meguri/core": "workspace:*",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.10",
    "valibot": "1.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "@types/node": "22.19.0",
    "drizzle-kit": "0.31.8",
    "miniflare": "5.20261006.2-beta",
    "wrangler": "4.150.0"
  }
}
