{
  "name": "@tailos/runner",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/runner.cjs",
    "test": "node --test scripts/check-bundle.mjs && vitest run --fsModuleCachePath node_modules/.vitest-cache",
    "typecheck": "tsc -b --stopBuildOnErrors"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "@tailos/core": "workspace:*",
    "valibot": "1.3.0",
    "@tailos/diagnostics": "workspace:*"
  }
}
