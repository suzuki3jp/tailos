{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meguri-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meguri",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
}
