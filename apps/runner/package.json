{
  "name": "@tailos/runner",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --external:@anthropic-ai/claude-agent-sdk --external:zod --outfile=dist/runner.cjs",
    "test": "node --test scripts/check-bundle.mjs && vitest run --fsModuleCachePath node_modules/.vitest-cache",
    "typecheck": "tsc -b --stopBuildOnErrors"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.319",
    "@types/node": "22.19.0",
    "esbuild": "0.28.2",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@tailos/core": "workspace:*",
    "@tailos/diagnostics": "workspace:*",
    "valibot": "1.3.0"
  }
}
