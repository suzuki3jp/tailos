# Copy to .dev.vars. Never commit the real values.
ADMIN_PASSWORD="replace-with-at-least-16-random-characters"
SESSION_SECRET="replace-with-at-least-32-random-characters"
CREDENTIAL_ENCRYPTION_KEY="replace-with-openssl-rand-base64-32-output"
MEGURI_GH_APP_ID="123456"
MEGURI_GH_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nREPLACE_ME\n-----END RSA PRIVATE KEY-----"
MEGURI_GH_WEBHOOK_SECRET="replace-with-a-random-webhook-secret"
