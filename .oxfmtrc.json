{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": false,
  "sortImports": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/.wrangler/**",
    "**/pnpm-lock.yaml",
    "**/temp/**",
    ".claude/worktrees/**",
    "**/*.{md,mdx}"
  ]
}
